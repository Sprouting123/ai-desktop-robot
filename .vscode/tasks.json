{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build RGB experiment (all variants)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/pio",
      "args": ["run", "-e", "diagnostics", "-e", "rgb_gpio48", "-e", "rgb_gpio38"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"]
    }
  ]
}
