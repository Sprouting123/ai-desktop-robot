# 实验 016 探针：ESP32-S3 N16R8 + ESP-SR 1.9.2 + ESP-IDF 4.4.7
CONFIG_IDF_TARGET="esp32s3"

# 16 MB QIO flash / 8 MB OPI PSRAM（与主工程已验证的硬件一致）
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
# IDF 4.4.7 的 S3 PSRAM 开关是 ESP32S3_SPIRAM_SUPPORT（它会 select SPIRAM）；
# 只写 CONFIG_SPIRAM=y 会被 Kconfig 忽略，导致运行期 psram_free=0。
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_ESPPSRAM64=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# 注意：IDF 4.4.7 + 本板 8MB OPI PSRAM 下启用 64KB data cache 会启动复位，
# 先用默认 32KB / 32B 验证 PSRAM 与模型加载，再单独评估 cache 配置。

# 自定义分区表（含 model 分区）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 串口控制台与主任务
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000

# 运行时间统计，用于估算 CPU 占用（探针测量，不进入主工程）
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# ESP-SR：AFE v1 + WakeNet9 中文模型“你好小智”
CONFIG_USE_AFE=y
CONFIG_AFE_INTERFACE_V1=y
CONFIG_USE_WAKENET=y
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y
CONFIG_MODEL_IN_FLASH=y
CONFIG_USE_NSNET=n
